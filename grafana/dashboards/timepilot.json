          "editorMode": "code",
          "expr": "(100 * (sum(rate(timepilot_http_requests_total{namespace=\"timepilot\",job=\"timepilot-web\",route=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(timepilot_http_requests_total{namespace=\"timepilot\",job=\"timepilot-web\",route=~\"/api/.*\"}[$__rate_interval]))) / sum(rate(timepilot_http_requests_total{namespace=\"timepilot\",job=\"timepilot-web\",route=~\"/api/.*\"}[$__rate_interval]))) and on() (sum(rate(timepilot_http_requests_total{namespace=\"timepilot\",job=\"timepilot-web\",route=~\"/api/.*\"}[$__rate_interval])) > 0)",
