        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "min(up{namespace=\"timepilot\",job=\"timepilot-web\"})",
          "legendFormat": "API",
          "refId": "A",
          "range": false,
          "instant": true
