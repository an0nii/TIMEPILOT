# Локальные значения для Docker Compose. Не используйте их в production.
POSTGRES_DB=timepilot
POSTGRES_USER=timepilot
POSTGRES_PASSWORD=timepilot
PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=40s
SHUTDOWN_TIMEOUT=10s

# Опциональный AI-планировщик. Ключ остаётся только на backend.
# AI_PROVIDER: disabled, openai, anthropic или gemini.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=30s

# Вместо AI_API_KEY можно задать нативную переменную выбранного провайдера:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
